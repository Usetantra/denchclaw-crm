# Required
DATABASE_URL=postgresql://denchclaw_app:<password>@localhost:5432/denchclaw
INTERNAL_API_KEY=<generate with: openssl rand -hex 32>

# Optional (defaults to loopback only)
INTERNAL_API_ALLOWED_CIDRS=127.0.0.1/32,::1/128

PORT=3100
NODE_ENV=production

# ─── Human sign-in (Clerk) ───────────────────────────────────────────────────
# Machines authenticate with INTERNAL_API_KEY above; humans authenticate with
# Clerk. The two paths are separate and neither falls through to the other.
#
# CLERK_SECRET_KEY is the master switch: with it (or CLERK_JWT_KEY) unset, the
# Clerk branch never engages and browser requests are refused once the proxy
# stops injecting a key. That is the intended fail-closed posture.
CLERK_SECRET_KEY=sk_live_<from the Clerk dashboard>
# Not a secret — it ships to every browser. Served to the page via
# GET /api/crm/auth/config so this static file works in every environment.
CLERK_PUBLISHABLE_KEY=pk_live_<from the Clerk dashboard>

# PEM public key (Clerk dashboard -> API keys -> Show JWT public key).
# Set this in production: verification becomes networkless, so a Clerk network
# blip cannot turn into a 401 storm. Newlines may be written as \n.
CLERK_JWT_KEY=

# This app's exact origin(s), comma-separated. Checks the token's `azp` claim.
# UNSET MEANS UNCHECKED — a token minted for a different application on the same
# Clerk instance would be accepted here. Always set it in production.
CLERK_AUTHORIZED_PARTIES=https://claw.usetantra.com

# Which tenant a brand-new Clerk identity may claim as owner — and ONLY while
# that tenant has zero users. Once one owner exists this path is dead forever
# and the only ways in are an invite or a hand-inserted row.
CLERK_BOOTSTRAP_COMPANY_ID=tantra
# Set to 0 to disable bootstrapping outright once the first owner exists.
CLERK_ALLOW_BOOTSTRAP=1

# Who may reach the CROSS-tenant surfaces (/tenants, /api-keys, /ops/fleet).
# Being an 'owner' is the right shape for running your own workspace and the
# wrong shape for administering everyone else's, so it is an explicit allowlist.
CLERK_SUPERADMIN_COMPANY_IDS=tantra
CLERK_SUPERADMIN_EMAILS=

# 1 = an invite may only be accepted by a Clerk identity whose email matches it.
# Default 0 treats the token itself as the capability (same model as the
# lead-webhook tokens), logging any mismatch.
INVITE_REQUIRE_EMAIL_MATCH=0

# 1 = DELETE /auth/users/:id also deletes the Clerk identity. Irreversible, and
# in a multi-tenant world it would destroy their other memberships too.
CLERK_DELETE_IDENTITY_ON_REMOVE=0

# ─── Public hostname ─────────────────────────────────────────────────────────
# These four are the ones that break SILENTLY when the hostname changes. The app
# never errors on a stale value — links just point somewhere dead and provider
# callbacks land on the wrong box. Change all of them together.

# Absolute base for team-invite links in email (…/crm?invite=<token>).
# Unset => the emailed link is relative, i.e. not clickable.
APP_URL=https://claw.usetantra.com

# Base for prospect-facing tracked marketing links (…/m/i/<token>).
# MARKETING_PUBLIC_BASE wins; PUBLIC_BASE_URL is the fallback. Unset => relative
# link pasted into an outbound email, which is not a link at all.
MARKETING_PUBLIC_BASE=https://claw.usetantra.com
PUBLIC_BASE_URL=https://claw.usetantra.com

# Twilio signs the FULL public URL, and this string is what we HMAC over. If it
# does not byte-match the URL Twilio actually posted to, every inbound SMS and
# WhatsApp is 403'd — which also stops STOP/opt-out being recorded, so this is a
# compliance dependency, not just a delivery one.
TWILIO_WEBHOOK_BASE_URL=https://claw.usetantra.com

# Stamped onto every outbound message at send time. Stale => sends still succeed
# but no delivery receipt ever comes back, so every message sits at "queued"
# forever and delivery analytics flatline.
TWILIO_STATUS_CALLBACK=https://claw.usetantra.com/webhooks/twilio/status

# ─── Inbound webhooks ────────────────────────────────────────────────────────
# Shared secret for POST /webhooks/email/inbound (x-webhook-secret header).
# Fails CLOSED: unset => the endpoint 503s and inbound email replies are lost.
# The same secret also guards the Twilio inbound simulation path.
INBOUND_WEBHOOK_SECRET=<openssl rand -hex 32>
