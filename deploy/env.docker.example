# ─── Compose-specific additions to .env ──────────────────────────────────────
# The full list of application settings lives in .env.example (Clerk, Twilio,
# hostnames, webhook secrets, …). THIS file only covers what changes because
# Postgres now runs as the `db` service inside the compose network.
#
# Workflow on the VM:
#     cp .env.example .env
#     cat deploy/env.docker.example >> .env      # append this block
#     # then edit .env: fill secrets, and REMOVE the localhost DATABASE_URL that
#     # came from .env.example so the one below (host = db) is the only one.

# The DB container is provisioned from these three on first boot (empty volume).
POSTGRES_USER=denchclaw
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=denchclaw

# App → DB. Host is the compose service name `db`, not localhost. The password
# MUST match POSTGRES_PASSWORD above. No sslmode: traffic never leaves the host.
DATABASE_URL=postgresql://denchclaw:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/denchclaw

# The app container sits BEHIND nginx on the compose network, so machine callers
# (if any) arrive from the bridge subnet, not loopback. Allow the private ranges
# Docker uses. Browser/Clerk traffic does not depend on this.
INTERNAL_API_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
